<?xml version="1.0" encoding="utf-8"?>
<!--
Fondo visual de cada fila de estudiante. No contiene datos ni eventos.
La fila y su contenido se definen en layout/fila_alumno.xml y el adaptador.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#252525" />
            <stroke android:width="1dp" android:color="@color/plata" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1E1E1E"
                android:endColor="#181818" />
            <stroke android:width="1dp" android:color="@color/borde_plata" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
