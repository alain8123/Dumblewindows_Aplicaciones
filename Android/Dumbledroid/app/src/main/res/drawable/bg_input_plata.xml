<?xml version="1.0" encoding="utf-8"?>
<!--
Fondo visual de campos de entrada. La validación del texto se hace en Kotlin,
no en este recurso de apariencia.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#161616" />
            <stroke android:width="1.5dp" android:color="@color/plata" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/negro_suave" />
            <stroke android:width="1dp" android:color="@color/borde_plata" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
