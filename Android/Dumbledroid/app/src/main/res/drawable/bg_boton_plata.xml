<?xml version="1.0" encoding="utf-8"?>
<!--
Fondo reutilizable de botones. Define su apariencia, no la acción que ejecutan.
Se referencia desde los layouts mediante @drawable/bg_boton_plata.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado pulsado -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
            <stroke android:width="1dp" android:color="@color/plata" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2E2E2E"
                android:endColor="#1A1A1A" />
            <stroke android:width="1dp" android:color="@color/borde_plata" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
