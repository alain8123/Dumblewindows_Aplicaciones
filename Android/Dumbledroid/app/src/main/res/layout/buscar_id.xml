<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginLeft="16dp"
        android:background="@drawable/bg_boton_plata"
        android:contentDescription="@string/flecha_menu"
        android:onClick="mostrar_menu"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/plata_clara"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:tooltipText="@string/volver"/>

    <ImageView
        android:id="@+id/boton_ayuda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="50dp"
        android:background="@drawable/bg_boton_plata"
        android:contentDescription="@string/boton_ayuda_formato_id"
        android:onClick="boton_ayuda_id"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/plata_clara"
        android:tooltipText="@string/ayuda_formato_del_id"/>

    <EditText
        android:id="@+id/et_estudiante"
        style="@style/InputPlata"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_boton_plata"
        android:ems="10"
        android:hint="@string/formato_id"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/bt_Buscar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:tooltipText="@string/insertar_id"/>

    <Button
        android:id="@+id/bt_Buscar"
        style="@style/BotonPlata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="80dp"
        android:onClick="buscar_estudiante_id"
        android:text="@string/hechizo_buscar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:tooltipText="@string/buscar_por_id"/>

</androidx.constraintlayout.widget.ConstraintLayout>