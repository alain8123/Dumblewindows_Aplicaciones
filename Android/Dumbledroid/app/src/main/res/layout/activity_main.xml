<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <Spinner
        android:id="@+id/selector_idioma"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:entries="@array/idiomas"
        android:tooltipText="Selector de idioma"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_menu_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="mostrar_busqueda_id"
        android:text="@string/buscar_por_id"
        android:tooltipText="Busqueda mediante ID"
        app:layout_constraintBottom_toTopOf="@id/bt_menu_datos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/bt_menu_datos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:onClick="mostrar_busqueda_datos"
        android:text="@string/buscar_por_datos"
        android:tooltipText="Busqueda mediante Datos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bt_menu_id" />

    <TextView
        android:id="@+id/texto_idiomas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:textSize="20dp"
        android:text="@string/idioma"
        app:layout_constraintBottom_toBottomOf="@+id/selector_idioma"
        app:layout_constraintEnd_toStartOf="@+id/selector_idioma"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>