<?xml version="1.0" encoding="utf-8"?>
<!--
Formulario de filtros: et_Nombre y et_Casa se leen en buscar_estudiante_datos.
Debe rellenarse al menos uno. bt_Buscar inicia la consulta; progress_cargando
es el indicador de espera. La ayuda y la flecha llaman a MainActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="48dp"
        android:layout_height="48dp"
    android:layout_marginLeft="16dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_boton_plata"
        android:contentDescription="@string/flecha_menu"
        android:onClick="mostrar_menu"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="@color/plata_clara"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:tooltipText="@string/volver"/>

    <ImageView
        android:id="@+id/boton_ayuda"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="50dp"
        android:background="@drawable/bg_boton_plata"
        android:contentDescription="@string/boton_ayuda_formato_id"
        android:onClick="boton_ayuda_datos"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_help"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/plata_clara"
        android:tooltipText="@string/ayuda_de_busqueda_por_datos"/>

    <EditText
        android:id="@+id/et_Nombre"
        style="@style/InputPlata"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_boton_plata"
        android:ems="10"
        android:hint="@string/nombre"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@id/et_Casa"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:tooltipText="@string/insertar_nombre"/>

    <EditText
        android:id="@+id/et_Casa"
        style="@style/InputPlata"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_boton_plata"
        android:ems="10"
        android:hint="@string/casa"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/bt_Buscar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_Nombre"
        app:layout_constraintVertical_bias="0.0"
        android:tooltipText="@string/insertar_casa"/>

    <Button
        android:id="@+id/bt_Buscar"
        style="@style/BotonPlata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="80dp"
        android:onClick="buscar_estudiante_datos"
        android:text="@string/hechizo_buscar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:tooltipText="@string/buscar_por_datos"/>

    <ProgressBar
        android:id="@+id/progress_cargando"
        style="@color/plata_brillo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
