<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/negro"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/detalle_imagen"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_boton_plata"
            android:contentDescription="@string/foto_alumno"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ejemplo"
            tools:ignore="Suspicious0dp" />

        <TextView
            android:id="@+id/detalle_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/plata_brillo"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/detalle_alias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/plata"
            android:textSize="20sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/detalle_casa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:paddingBottom="12dp"
            android:textColor="@color/plata_oscura"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detalle_especie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/plata_clara"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detalle_genero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/plata_clara"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detalle_fecha_nacimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/plata_clara"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detalle_patronus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/plata_clara"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/detalle_nacionalidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/plata_clara"
            android:textSize="16sp" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/BotonPlata"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="30dp"
            android:onClick="mostrar_menu"
            android:text="@string/volver" />

    </LinearLayout>
</ScrollView>