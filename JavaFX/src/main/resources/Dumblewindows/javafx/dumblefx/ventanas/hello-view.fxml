<?xml version="1.0" encoding="UTF-8"?>
<!-- Ventana principal con menú, selector de idioma, ayudas y contenedor de pantallas.
     fx:id enlaza controles con el controlador; onAction referencia sus métodos.
     Los textos con % son claves de traducción y styleClass remite a app.css. -->

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Dumblewindows.javafx.dumblefx.controllers.MainController" styleClass="app">
  <left>
    <VBox spacing="9" styleClass="sidebar" prefWidth="248">
      <ComboBox fx:id="languageSelector" value="Español" maxWidth="Infinity" accessibleText="%language" styleClass="language-selector">
        <items>
          <FXCollections fx:factory="observableArrayList">
            <String fx:value="Español" />
            <String fx:value="Inglés" />
            <String fx:value="Euskera" />
          </FXCollections>
        </items>
      </ComboBox>
      <Label text="DumbleFX" styleClass="brand" />
      <Label fx:id="lbl_SideText" text="%sidebar.heading" styleClass="eyebrow" />
      <Separator />
      <Button fx:id="idButton" text="%nav.id" onAction="#id" maxWidth="Infinity" styleClass="nav-button"><tooltip><Tooltip text="%tooltip.navId" /></tooltip></Button>
      <Button fx:id="dataButton" text="%nav.data" onAction="#data" maxWidth="Infinity" styleClass="nav-button"><tooltip><Tooltip text="%tooltip.navData" /></tooltip></Button>
      <Button fx:id="createButton" text="%nav.create" onAction="#create" maxWidth="Infinity" styleClass="nav-button"><tooltip><Tooltip text="%tooltip.navCreate" /></tooltip></Button>
      <Button fx:id="deleteButton" text="%nav.delete" onAction="#delete" maxWidth="Infinity" styleClass="nav-button"><tooltip><Tooltip text="%tooltip.navDelete" /></tooltip></Button>
      <Button fx:id="updateButton" text="%nav.update" onAction="#update" maxWidth="Infinity" styleClass="nav-button"><tooltip><Tooltip text="%tooltip.navUpdate" /></tooltip></Button>
      <Region VBox.vgrow="ALWAYS" />
      <Label fx:id="lbl_SideNote" text="%sidebar.note" styleClass="side-note" />
      <HBox alignment="CENTER_RIGHT">
        <Label fx:id="creditsIcon" text="©" styleClass="info-icon" />
      </HBox>
    </VBox>
  </left>
  <center>
    <VBox spacing="20" styleClass="workspace">
      <HBox alignment="TOP_RIGHT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
          <Label fx:id="lbl_PaneText" text="%panel.title" styleClass="overline" />
          <Label fx:id="sectionTitle" text="%nav.id" styleClass="page-title" />
        </VBox>
        <Label fx:id="helpIcon" text="?" styleClass="info-icon" />
      </HBox>
      <StackPane fx:id="content" VBox.vgrow="ALWAYS" />
    </VBox>
  </center>
</BorderPane>
