<?xml version="1.0" encoding="UTF-8"?>
<!-- Carga y muestra el registro antes de solicitar confirmación para eliminarlo.
     fx:id enlaza controles con el controlador; onAction referencia sus métodos.
     Los textos con % son claves de traducción y styleClass remite a app.css. -->

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="operationPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alain.holamundo.dumblefx.controllers.StudentController" spacing="18" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
  <Label text="%nav.delete" styleClass="card-title" />
  <Label text="%delete.hint" styleClass="hint" wrapText="true" />
  <HBox spacing="10"><TextField fx:id="idField" promptText="%field.id" onAction="#loadForDelete" /><Button text="%action.consult" onAction="#loadForDelete" styleClass="secondary"><tooltip><Tooltip text="%tooltip.loadDelete" /></tooltip></Button></HBox>
  <Label fx:id="result" text="%delete.initial" wrapText="true" styleClass="result" maxWidth="Infinity" />
  <Button text="%nav.delete" onAction="#delete" styleClass="danger"><tooltip><Tooltip text="%tooltip.delete" /></tooltip></Button>
  <Label fx:id="status" text="%status.ready" styleClass="status" />
</VBox>
