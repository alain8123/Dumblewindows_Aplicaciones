<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="operationPane" maxHeight="Infinity" maxWidth="Infinity" spacing="16" styleClass="card" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alain.holamundo.dumblefx.controllers.StudentController">
  <Label styleClass="card-title" text="%nav.data" />
  <Label styleClass="hint" text="%search.hint" wrapText="true" />
  <HBox spacing="10"><TextField fx:id="searchField" onAction="#search" promptText="%field.nameOptional" HBox.hgrow="ALWAYS" /><TextField fx:id="houseFilterField" onAction="#search" promptText="%field.houseOptional" /></HBox>
  <HBox spacing="10"><Label text="%field.limit" /><TextField fx:id="limitField" onAction="#search" prefWidth="85" promptText="1–100" text="20" /><Button onAction="#search" styleClass="primary" text="%action.search" /></HBox>
  <TableView fx:id="table" VBox.vgrow="ALWAYS">
    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
    <columns><TableColumn fx:id="idColumn" prefWidth="170" text="ID" /><TableColumn fx:id="nameColumn" prefWidth="200" text="%field.name" /><TableColumn fx:id="surnameColumn" prefWidth="170" text="%field.surname" /><TableColumn fx:id="houseColumn" prefWidth="130" text="%field.house" /><TableColumn fx:id="birthColumn" prefWidth="120" text="%field.birth" /></columns>
  </TableView>
  <Label fx:id="status" styleClass="status" text="%status.searchInitial" />
</VBox>
