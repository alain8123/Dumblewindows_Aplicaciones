<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="operationPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alain.holamundo.dumblefx.controllers.StudentController" spacing="17" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
  <Label text="Crear estudiante" styleClass="card-title" />
  <Label text="Crea una matrícula nueva en MariaDB. No modifica las bases históricas." styleClass="hint" wrapText="true" />
  <GridPane hgap="15" vgap="10">
    <Label text="ID del estudiante *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" /><Label text="Nombre completo *" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <TextField fx:id="idField" promptText="Texto o UUID (máx. 64)" GridPane.columnIndex="0" GridPane.rowIndex="1" /><TextField fx:id="nameField" promptText="Nombre y apellidos" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <Label text="Casa" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" /><Label text="Fecha de nacimiento" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <TextField fx:id="houseField" promptText="Casa (opcional)" GridPane.columnIndex="0" GridPane.rowIndex="3" /><TextField fx:id="birthDateField" promptText="AAAA-MM-DD (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="3" />
  </GridPane>
  <Button text="Crear estudiante" onAction="#create" styleClass="primary" />
  <Label fx:id="status" text="* Campos obligatorios" styleClass="status" />
</VBox>
