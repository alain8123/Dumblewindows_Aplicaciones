<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox fx:id="operationPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="alain.holamundo.dumblefx.controllers.StudentController" spacing="17" styleClass="card" maxWidth="Infinity" maxHeight="Infinity">
  <Label text="%nav.create" styleClass="card-title" />
  <Label text="%create.hint" styleClass="hint" wrapText="true" />
  <GridPane hgap="15" vgap="10">
    <Label text="%field.idRequired" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" /><Label text="%field.nameRequired" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="0" />
    <TextField fx:id="idField" promptText="%field.idPrompt" GridPane.columnIndex="0" GridPane.rowIndex="1" /><TextField fx:id="nameField" promptText="%field.namePrompt" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    <Label text="%field.house" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" /><Label text="%field.birthDate" styleClass="field-label" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    <TextField fx:id="houseField" promptText="%field.houseOptional" GridPane.columnIndex="0" GridPane.rowIndex="3" /><TextField fx:id="birthDateField" promptText="%field.datePrompt" GridPane.columnIndex="1" GridPane.rowIndex="3" />
  </GridPane>
  <Button text="%nav.create" onAction="#create" styleClass="primary" />
  <Label fx:id="status" text="%status.required" styleClass="status" />
</VBox>
